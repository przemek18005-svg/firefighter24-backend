# Skopiuj ten plik do .env i uzupełnij wartości przed uruchomieniem.

# Wymagane. Wygeneruj długi losowy ciąg, np.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opcjonalne — domyślnie 3001
PORT=3001

# Opcjonalne — domyślnie plik firefighter24.db w tym folderze.
# Na hostingu z trwałym wolumenem ustaw ścieżkę do niego, np. /data/firefighter24.db
DB_PATH=
